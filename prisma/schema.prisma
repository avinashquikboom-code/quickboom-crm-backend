  halfDayDeductionPct        Float           @default(50.0)
  lateArrivalDeductionPct    Float           @default(25.0)
  earlyCheckoutDeductionPct  Float           @default(25.0)
  breakExcessDeductionPct    Float           @default(100.0)
  minWorkingHoursForHalfDay  Float           @default(4.0)
  overtimeEligible           Boolean         @default(true)
  breakAllowed               Boolean         @default(true)
  breakRequired              Boolean         @default(false)
  maxBreakDurationMins       Int             @default(60)
  minBreakDurationMins       Int             @default(15)
  maxBreaksPerDay            Int             @default(2)
  breakGracePeriodMins       Int             @default(5)
  breakType                  String          @default("UNPAID")
  breakExcessAction          String          @default("DEDUCT_EXCESS")
