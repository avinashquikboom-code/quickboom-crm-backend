  templateId        Int?
  appointmentId     Int?
  planId            Int?
  channel           String?  @default("EMAIL")
  identifierKey     String?
  recipientEmail    String
  subject           String
  renderedContent   String?  @db.Text
  eventType         String?  @default("GENERAL")
  previousStage     String?
  newStage          String?
  status            String   @default("SENT") // SENT, FAILED
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime @default(now())
  createdAt         DateTime @default(now())

  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  template EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([templateId])
  @@index([appointmentId])
  @@index([planId])
  @@index([identifierKey])
  @@index([recipientEmail])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
  @@map("email_logs")
}

model MetaTemplate {
  id              Int       @id @default(autoincrement())
  name            String
  templateName    String
  key             String?
  language        String    @default("en_US")
  category        String    @default("UTILITY") // MARKETING, UTILITY, AUTHENTICATION
  status          String    @default("APPROVED") // APPROVED, PENDING, REJECTED, PAUSED, DISABLED
  metaTemplateId  String?
  headerType      String?   @default("NONE") // NONE, TEXT, IMAGE, DOCUMENT, VIDEO
  headerContent   String?   @db.Text
  body            String    @db.Text
  footer          String?
  buttons         Json?
  variables       String[]  @default([])
  rejectionReason String?
  isLocalActive   Boolean   @default(true)
  isSystem        Boolean   @default(false)
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([templateName])
  @@index([key])
  @@index([status])
  @@index([isLocalActive])
  @@index([deletedAt])
  @@map("meta_templates")
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum CommissionConfigStatus {
  ACTIVE
  INACTIVE
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

model CommissionConfig {
  id              Int                    @id @default(autoincrement())
  employeeId      Int                    @unique
  commissionType  CommissionType         @default(PERCENTAGE)
  commissionValue Float                  @default(0)
  status          CommissionConfigStatus @default(ACTIVE)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@map("commission_configs")
}

model Commission {
  id               Int               @id @default(autoincrement())
  employeeId       Int?
  sourceKey        String?           @unique
  teamId           Int?
  leaderId         Int?
  reviewReason     String?
  qualifyingAt     DateTime?
  history          Json?
  shares           CommissionShare[]
  planId           Int?
  purchaseId       Int?              @unique @map("purchase_id")
  orderId          String?           @map("order_id")
  commissionType   CommissionType
  commissionRate   Float             @default(0)
  purchaseAmount   Float             @default(0)
  commissionAmount Float             @default(0)
  status           CommissionStatus  @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  employee Employee?       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  plan     Plan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  purchase PaymentHistory? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([planId])
  @@index([purchaseId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@index([qualifyingAt])
  @@map("commissions")
}

model CommissionShare {
  id            Int              @id @default(autoincrement())
  commissionId  Int
  employeeId    Int
  recipientRole String
  effectiveRate Float
  amount        Float
  status        CommissionStatus @default(APPROVED)
  paidAt        DateTime?
  payrollItemId Int?
  commission    Commission       @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payrollItem   PayrollItem?     @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)

  @@unique([commissionId, recipientRole])
  @@unique([commissionId, employeeId])
  @@index([employeeId, status])
  @@index([payrollItemId])
  @@map("commission_shares")
}

// Independent single-organization Lead workflow; no Customer or RBAC dependencies.
model Lead {
  customer Customer?
  id                 Int                @id @default(autoincrement())
  companyName        String
  firstName          String?
  lastName           String?
  phone              String?
  email              String?
  website            String?
  address            String?
  city               String?
  state              String?
  country            String?
  pincode            String?
  category           String?
  googlePlaceId      String?            @unique
  latitude           Float?
  longitude          Float?
  source             String             @default("MANUAL")
  createdFrom        RecordCreatedFrom  @default(ADMIN_PANEL)
  status             CrmLeadStatus      @default(NEW)
  notes              String?
  assignedToId       Int?
  createdById        Int
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  assignedTo         Employee?          @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy          User               @relation("LeadCreator", fields: [createdById], references: [id], onDelete: Restrict)
  dataCaptureRecords DataCapturePlace[]

  @@index([deletedAt, createdAt])
  @@index([assignedToId])
  @@index([createdById])
  @@map("crm_leads")
}

enum CrmLeadStatus {
  NEW
  CONTACTED
  DETAILS_SEND
  FOLLOW_UP
  VISIT_SCHEDULED
  VISIT_DONE
  PROPOSAL_SENT
  NEGOTIATION
  FINAL_CALL
  WON
  LOST
}

// Customer billing for the current single organization. Legacy billing rows remain untouched.
model Customer {
  id Int @id @default(autoincrement())
  originLeadId Int @unique
  userId Int? @unique
  companyName String
  firstName String?
  lastName String?
  email String?
  phone String?
  status CustomerLifecycleStatus @default(INACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead Lead @relation(fields: [originLeadId], references: [id], onDelete: Restrict)
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscriptions CustomerSubscription[]
  checkouts CustomerCheckout[]
  @@map("customer_accounts")
}

enum CustomerLifecycleStatus {
  INACTIVE
  ACTIVE
}

model CustomerSubscription {
  id Int @id @default(autoincrement())
  customerId Int
  planId Int
  checkoutId String @unique
  status String @default("PENDING_ACTIVATION")
  startDate DateTime
  endDate DateTime
  activationDate DateTime?
  createdAt DateTime @default(now())
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
  checkout CustomerCheckout @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  @@index([customerId, status, endDate])
  @@index([status, activationDate])
  @@map("customer_subscriptions")
}

model CustomerCheckout {
  id String @id @default(uuid())
  customerId Int
  planId Int
  idempotencyKey String
  billingCycle SubscriptionBillingCycle
  basePaise Int
  discountPaise Int
  taxablePaise Int
  gstPaise Int
  totalPaise Int
  taxRateBps Int
  yearlyDiscountBps Int
  status String @default("PENDING")
  orderId String? @unique
  paymentId String? @unique
  paymentHistoryId Int? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription CustomerSubscription?
  @@unique([customerId, idempotencyKey])
  @@map("customer_checkouts")
}
