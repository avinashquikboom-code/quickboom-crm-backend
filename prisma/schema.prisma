  @@index([customerId])
}

model TeamMember {
  id         Int      @id @default(autoincrement())
  teamId     Int
  employeeId Int
  role       String   @default("MEMBER")
  joinedAt   DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, employeeId])
  @@index([teamId])
  @@index([employeeId])
}

model PlanEntitlement {
  id           Int       @id @default(autoincrement())
  customerId   Int
  planId       Int?
  serviceName  String
  totalQty     Int       @default(0)
  usedQty      Int       @default(0)
  scheduledQty Int       @default(0)
  validUntil   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  works        Work[]

  @@index([customerId])
}

model Work {
  id            Int              @id @default(autoincrement())
  customerId    Int
  planId        Int?
  entitlementId Int?
  teamId        Int?
  assignedToId  Int?
  workType      WorkType         @default(REELS_SHOOT)
  title         String
  description   String?
  scheduledDate DateTime         @default(now())
  scheduledTime String?
  status        WorkStatus       @default(SCHEDULED)
  priority      WorkPriority     @default(MEDIUM)
  notes         String?
  outputUrl     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  assignedTo    Employee?        @relation(fields: [assignedToId], references: [id])
  customer      Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  entitlement   PlanEntitlement? @relation(fields: [entitlementId], references: [id])
  team          Team?            @relation(fields: [teamId], references: [id])
  tasks         WorkTask[]

  @@index([customerId])
  @@index([teamId])
  @@index([assignedToId])
  @@index([scheduledDate])
  @@index([status])
}

model WorkTask {
  id           Int        @id @default(autoincrement())
  workId       Int
  title        String
  stepOrder    Int        @default(1)
  assignedToId Int?
  status       TaskStatus @default(PENDING)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignedTo   Employee?  @relation(fields: [assignedToId], references: [id])
  work         Work       @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@index([assignedToId])
}

