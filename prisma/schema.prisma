model MonthlySchedule {
  id                 Int            @id @default(autoincrement())
  customerId         Int
  subscriptionId     Int?
  planId             Int?
  month              Int
  year               Int
  startDate          DateTime
  endDate            DateTime
  status             ScheduleStatus @default(PLANNED)
  assignedEmployeeId Int?
  title              String?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  customer         Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscription     CustomerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan             Plan?                 @relation(fields: [planId], references: [id], onDelete: SetNull)
  assignedEmployee Employee?             @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  @@unique([customerId, subscriptionId, month, year])
  @@index([customerId])
  @@index([subscriptionId])
  @@index([planId])
  @@index([assignedEmployeeId])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
  @@index([month, year])
  @@index([deletedAt])
  @@map("monthly_schedules")
}

model CustomPlanOption {
  id                   Int       @id @default(autoincrement())
  name                 String
  code                 String    @unique
  description          String?
  category             String    @default("CONTENT") // CONTENT, CREATIVES, ADS, CRM, STORAGE, SUPPORT
  monthlyPrice         Float
  pricingType          String    @default("PER_UNIT") // FLAT, PER_UNIT
  unitName             String?   @default("unit")
  minQuantity          Int       @default(1)
  maxQuantity          Int       @default(100)
  defaultQuantity      Int       @default(1)
  isIncludedInStandard Boolean   @default(false)
  isActive             Boolean   @default(true)
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  @@index([category])
  @@index([isActive])
  @@index([deletedAt])
  @@map("custom_plan_options")
}

model CustomPlanOrder {
  id               Int           @id @default(autoincrement())
  customerId       Int
  subscriptionId   Int?
  orderNumber      String        @unique
  selectedFeatures Json
  duration         Int           @default(1) // duration in months
  durationUnit     String        @default("MONTH")
  subtotal         Float
  discount         Float         @default(0)
  tax              Float         @default(0)
  totalAmount      Float
  currency         String        @default("INR")
  status           String        @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAID, ACTIVATED, CANCELLED, EXPIRED
  paymentMethod    PaymentMethod @default(RAZORPAY)
  paymentId        String?
  orderId          String?
  transactionId    String?
  startDate        DateTime?
  expiryDate       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscription CustomerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([subscriptionId])
  @@index([orderNumber])
  @@index([status])
  @@index([deletedAt])
  @@map("custom_plan_orders")
}

model IntegrationSetting {
  id              Int       @id @default(autoincrement())
  provider        String    @unique // e.g. "RAZORPAY", "GOOGLE_MAPS", "TWILIO", "WHATSAPP", "SENDGRID"
  isEnabled       Boolean   @default(true)
  environment     String    @default("LIVE") // "LIVE" | "TEST"
  credentials     Json // Encrypted payload of sensitive fields (e.g. keySecret, apiKey) + plain identifiers (e.g. keyId, webhookSecret)
  config          Json? // Provider-specific non-sensitive configurations (e.g. routing, geocoding options)
  updatedByUserId Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([provider, isEnabled])
  @@index([deletedAt])
  @@map("integration_settings")
}

model PaymentSetting {
  id                    Int      @id @default(autoincrement())
  singletonKey          String   @unique @default("DEFAULT")
  razorpayEnabled       Boolean  @default(true)
  paymentMode           String   @default("TEST") // "TEST" | "LIVE"
  razorpayTestKeyId     String?  @default("")
  razorpayTestKeySecret String?  @default("")
  razorpayLiveKeyId     String?  @default("")
  razorpayLiveKeySecret String?  @default("")
  offlinePaymentEnabled Boolean  @default(false)
  updatedByUserId       Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("payment_settings")
}

