// QuikBoom Enterprise SaaS CRM Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  SUPER_ADMIN
  CUSTOMER_ADMIN
  SALES_MANAGER
  SALES_EXECUTIVE
  SUPPORT_AGENT
  CUSTOM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum SubscriptionBillingCycle {
  MONTHLY
  YEARLY
}

enum LeadStatus {
  NEW
  FOLLOW_UP
  CONTACTED
  VISIT
  QUALIFIED
  PROPOSAL
  PROPOSAL_SENT
  FINAL_CALL
  NEGOTIATION
  PAYMENT
  WORK_STARTED
  WON
  LOST
  CANCELLED
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ContactType {
  CUSTOMER
  VENDOR
  PARTNER
  PROSPECT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum PaymentMethod {
  RAZORPAY
  BANK_TRANSFER
  CASH
  CREDIT_CARD
  OTHER
}

// ----------------------------------------------------
// MULTI-TENANCY & SUBSCRIPTION
// ----------------------------------------------------

model Customer {
  @@map("customers")
  id           String    @id @default(uuid())
  name         String
  domain       String?   @unique
  logo         String?
  phone        String?
  email        String?
  address      String?
  city         String?
  state        String?
  country      String?
  isActive     Boolean   @default(true)
  storageUsed  BigInt    @default(0) // in bytes
  userLimit    Int       @default(5)
  leadLimit    Int       @default(500)
  storageLimit BigInt    @default(5368709120) // 5GB in bytes
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  users         User[]
  roles         Role[]
  subscriptions CustomerSubscription[]
  leads         Lead[]
  contacts      Contact[]
  companies     Company[]
  deals         Deal[]
  pipelines     Pipeline[]
  tasks         Task[]
  products      Product[]
  quotations    Quotation[]
  invoices      Invoice[]
  tickets       SupportTicket[]
  notifications Notification[]
  auditLogs     AuditLog[]
  payments      PaymentHistory[]
  featureToggles FeatureToggle[]
  employeeLocations EmployeeLocation[]
  branchGeofences   BranchGeofence[]
  locationTrackingSettings LocationTrackingSetting[]
  departments   Department[]
  designations  Designation[]
  employees     Employee[]
  payrolls      Payroll[]
  payrollPolicy PayrollPolicy?

  @@index([deletedAt])
  @@index([isActive])
}

model Plan {
  id           String                   @id @default(uuid())
  name         String                   @unique // Starter, Professional, Business, Enterprise
  code         String                   @unique
  description  String?
  monthlyPrice Float
  yearlyPrice  Float
  userLimit    Int
  leadLimit    Int
  storageLimit BigInt // in bytes
  features     Json // Enabled feature list
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  deletedAt    DateTime?

  subscriptions CustomerSubscription[]

  @@index([deletedAt])
}

model CustomerSubscription {
  @@map("customer_subscriptions")
  id           String                   @id @default(uuid())
  customerId     String
  planId       String
  status       SubscriptionStatus       @default(TRIAL)
  billingCycle SubscriptionBillingCycle @default(MONTHLY)
  startDate    DateTime
  endDate      DateTime
  trialEndsAt  DateTime?
  autoRenew    Boolean                  @default(true)
  couponId     String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  deletedAt    DateTime?

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan   Plan    @relation(fields: [planId], references: [id])
  coupon Coupon? @relation(fields: [couponId], references: [id])

  payments PaymentHistory[]

  @@index([customerId])
  @@index([planId])
  @@index([status])
  @@index([deletedAt])
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountPct   Float
  maxRedemptions Int      @default(100)
  timesRedeemed Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  subscriptions CustomerSubscription[]

  @@index([code])
}

model PaymentHistory {
  id             String        @id @default(uuid())
  customerId       String
  subscriptionId String?
  amount         Float
  currency       String        @default("INR")
  paymentMethod  PaymentMethod @default(RAZORPAY)
  paymentId      String? // Razorpay payment ID
  orderId        String? // Razorpay order ID
  status         String // SUCCESS, FAILED, PENDING
  invoiceUrl     String?
  // Order snapshot at time of purchase — plan may change/be deleted later.
  orderNumber   String?
  planId        String?
  planName      String?
  billingCycle  SubscriptionBillingCycle?
  taxAmount     Float?
  totalAmount   Float?
  transactionId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  customer       Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscription CustomerSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([customerId])
  @@index([deletedAt])
}

// ----------------------------------------------------
// USER & RBAC
// ----------------------------------------------------

model User {
  id           String    @id @default(uuid())
  customerId     String? // Null for Super Admin
  email        String    @unique
  phone        String?   @unique
  passwordHash String
  firstName    String
  lastName     String
  avatar       String?
  designation  String?
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(false)
  otpCode      String?
  otpExpiresAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  sessions      Session[]

  assignedLeads     Lead[]           @relation("AssignedLeads")
  createdLeads      Lead[]           @relation("CreatedLeads")
  assignedTasks     Task[]           @relation("AssignedTasks")
  createdTasks      Task[]           @relation("CreatedTasks")
  assignedTickets   SupportTicket[]  @relation("AssignedTickets")
  createdTickets    SupportTicket[]  @relation("CreatedTickets")
  notifications     Notification[]
  auditLogs         AuditLog[]
  employee          Employee?
  leadNotes         LeadNote[]
  ticketComments    TicketComment[]

  @@index([customerId])
  @@index([email])
  @@index([phone])
  @@index([deletedAt])
}

model Role {
  id          String    @id @default(uuid())
  customerId    String? // Null for System Roles
  name        String
  type        RoleType  @default(CUSTOM)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([customerId])
  @@index([deletedAt])
}

model Permission {
  id          String   @id @default(uuid())
  module      String // e.g., LEADS, DEALS, INVOICES
  action      String // e.g., CREATE, READ, UPDATE, DELETE, MANAGE
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@unique([module, action])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String?
  userAgent String?
  device    String?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------
// CRM CORE: LEADS, CONTACTS, COMPANIES, DEALS
// ----------------------------------------------------

model Lead {
  id               String       @id @default(uuid())
  customerId         String
  title            String
  firstName        String
  lastName         String
  email            String?
  phone            String?
  companyName      String?
  website          String?
  address          String?
  city             String?
  state            String?
  category         String?
  source           String       @default("WEBSITE") // WEBSITE, REFERRAL, SOCIAL, DIRECT, DATA_CAPTURE, OTHER
  status           LeadStatus   @default(NEW)
  priority         LeadPriority @default(MEDIUM)
  value            Float        @default(0)
  assignedToId     String?
  createdById      String
  nextFollowUpDate DateTime?
  nextFollowUpTime String?
  workStartDate    DateTime?
  workNotes        String?
  assignedTeam     String?
  paidAmount       Float?       @default(0)
  paymentStatus    String?      @default("PENDING")
  paymentMethod    String?
  paymentRef       String?
  convertedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo User?  @relation("AssignedLeads", fields: [assignedToId], references: [id])
  createdBy  User   @relation("CreatedLeads", fields: [createdById], references: [id])

  notes         LeadNote[]
  timeline      LeadActivityTimeline[]
  reminders     LeadReminder[]
  statusHistory LeadStatusHistory[]
  visits        Visit[]
  quotations    Quotation[]

  @@index([customerId])
  @@index([status])
  @@index([assignedToId])
  @@index([deletedAt])
}

model LeadStatusHistory {
  id          String      @id @default(uuid())
  leadId      String
  fromStatus  LeadStatus?
  toStatus    LeadStatus
  changedById String?
  notes       String?
  createdAt   DateTime    @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([leadId])
}

model LeadActivityTimeline {
  id          String   @id @default(uuid())
  leadId      String
  action      String // e.g. STATUS_CHANGED, NOTE_ADDED, CALL_LOGGED
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadReminder {
  id          String   @id @default(uuid())
  leadId      String
  remindAt    DateTime
  title       String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Company {
  id        String    @id @default(uuid())
  customerId  String
  name      String
  domain    String?
  industry  String?
  phone     String?
  email     String?
  address   String?
  city      String?
  country   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contacts Contact[]
  deals    Deal[]

  @@index([customerId])
  @@index([deletedAt])
}

model Contact {
  id          String      @id @default(uuid())
  customerId    String
  companyId   String?
  type        ContactType @default(CUSTOMER)
  firstName   String
  lastName    String
  email       String?
  phone       String?
  designation String?
  tags        String[]
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])

  deals          Deal[]
  communications CommunicationHistory[]
  quotations     Quotation[]
  invoices       Invoice[]

  @@index([customerId])
  @@index([companyId])
  @@index([deletedAt])
}

model CommunicationHistory {
  id        String   @id @default(uuid())
  contactId String
  type      String // EMAIL, CALL, MEETING, SMS, WHATSAPP
  summary   String
  details   String?
  timestamp DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model Pipeline {
  id        String    @id @default(uuid())
  customerId  String
  name      String
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  deals  Deal[]

  @@index([customerId])
  @@index([deletedAt])
}

model PipelineStage {
  id          String   @id @default(uuid())
  pipelineId  String
  name        String
  order       Int
  probability Float    @default(50.0) // 0 to 100%
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId])
}

model Deal {
  id              String    @id @default(uuid())
  customerId        String
  pipelineId      String
  stageId         String
  contactId       String?
  companyId       String?
  title           String
  amount          Float
  expectedClosing DateTime?
  probability     Float     @default(50.0)
  isWon           Boolean   @default(false)
  isLost          Boolean   @default(false)
  lostReason      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pipeline Pipeline      @relation(fields: [pipelineId], references: [id])
  stage    PipelineStage @relation(fields: [stageId], references: [id])
  contact  Contact?      @relation(fields: [contactId], references: [id])
  company  Company?      @relation(fields: [companyId], references: [id])

  quotations Quotation[]

  @@index([customerId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([deletedAt])
}

// ----------------------------------------------------
// TASKS, CALENDAR & PRODUCTS
// ----------------------------------------------------

model Task {
  id           String       @id @default(uuid())
  customerId     String
  title        String
  description  String?
  status       TaskStatus   @default(PENDING)
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?
  isRecurring  Boolean      @default(false)
  recurrence   String? // DAILY, WEEKLY, MONTHLY
  assignedToId String?
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo User?  @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdBy  User   @relation("CreatedTasks", fields: [createdById], references: [id])

  @@index([customerId])
  @@index([assignedToId])
  @@index([status])
  @@index([deletedAt])
}

model Product {
  id          String    @id @default(uuid())
  customerId    String
  name        String
  sku         String
  description String?
  unitPrice   Float
  currency    String    @default("INR")
  taxRate     Float     @default(18.0)
  stock       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  quotationItems QuotationItem[]
  invoiceItems   InvoiceItem[]

  @@unique([customerId, sku])
  @@index([customerId])
  @@index([deletedAt])
}

model Quotation {
  id            String          @id @default(uuid())
  customerId      String
  contactId     String?
  dealId        String?
  leadId        String?
  quotationNo   String
  status        QuotationStatus @default(DRAFT)
  subTotal      Float
  taxAmount     Float
  discount      Float           @default(0)
  totalAmount   Float
  validUntil    DateTime
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact  Contact?       @relation(fields: [contactId], references: [id])
  deal     Deal?          @relation(fields: [dealId], references: [id])
  lead     Lead?          @relation(fields: [leadId], references: [id])
  items    QuotationItem[]
  invoices Invoice[]

  @@index([customerId])
  @@index([contactId])
  @@index([leadId])
  @@index([deletedAt])
}

model QuotationItem {
  id          String @id @default(uuid())
  quotationId String
  productId   String
  quantity    Int
  unitPrice   Float
  total       Float

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
}

model Invoice {
  id          String        @id @default(uuid())
  customerId    String
  contactId   String
  quotationId String?
  invoiceNo   String
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime
  dueDate     DateTime
  subTotal    Float
  taxAmount   Float
  discount    Float         @default(0)
  totalAmount Float
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact   Contact      @relation(fields: [contactId], references: [id])
  quotation Quotation?   @relation(fields: [quotationId], references: [id])
  items     InvoiceItem[]

  @@index([customerId])
  @@index([contactId])
  @@index([status])
  @@index([deletedAt])
}

model InvoiceItem {
  id        String @id @default(uuid())
  invoiceId String
  productId String
  quantity  Int
  unitPrice Float
  total     Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// ----------------------------------------------------
// SUPPORT TICKETS
// ----------------------------------------------------

model SupportTicket {
  id           String         @id @default(uuid())
  customerId     String
  ticketNo     String
  subject      String
  description  String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  assignedToId String?
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo User?  @relation("AssignedTickets", fields: [assignedToId], references: [id])
  createdBy  User   @relation("CreatedTickets", fields: [createdById], references: [id])

  comments TicketComment[]

  @@index([customerId])
  @@index([status])
  @@index([deletedAt])
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  userId    String
  comment   String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id])

  @@index([ticketId])
}

// ----------------------------------------------------
// NOTIFICATIONS, AUDIT & SUPER ADMIN
// ----------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  customerId  String
  userId    String
  title     String
  message   String
  type      String // LEAD_ASSIGNED, TASK_DUE, PAYMENT_RECEIVED, SYSTEM
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id        String   @id @default(uuid())
  customerId  String?
  userId    String?
  action    String // CREATE, UPDATE, DELETE, LOGIN, EXPORT
  module    String // LEADS, DEALS, USERS, TENANTS
  details   Json
  ipAddress String?
  createdAt DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id])

  @@index([customerId])
  @@index([userId])
  @@index([module])
}

model FeatureToggle {
  id        String   @id @default(uuid())
  customerId  String
  feature   String // LEADS, DEALS, INVOICES, WHATSAPP_INTEGRATION
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, feature])
}

// ----------------------------------------------------
// GEO TRACKING & LOCATION MODELS
// ----------------------------------------------------

enum TrackingType {
  ATTENDANCE
  VISIT
  WORKING_HOURS
  MANUAL
}

enum TrackingMode {
  OFF
  ATTENDANCE_ONLY
  DURING_VISIT
  WORKING_HOURS
  ACTIVE_TRACKING
}

enum LocationPermissionStatus {
  GRANTED
  DENIED
  UNAVAILABLE
}

model EmployeeLocation {
  id           String       @id @default(uuid())
  customerId     String
  employeeId   String
  latitude     Float
  longitude    Float
  accuracy     Float?
  address      String?
  trackingType TrackingType @default(ATTENDANCE)
  attendanceId String?
  visitId      String?
  timestamp    DateTime     @default(now())
  createdAt    DateTime     @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([employeeId])
  @@index([timestamp])
}

model BranchGeofence {
  id            String   @id @default(uuid())
  customerId      String
  name          String
  city          String?
  latitude      Float
  longitude     Float
  radiusMeters  Float    @default(200.0) // Allowed radius in meters
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([isActive])
}

model LocationTrackingSetting {
  id               String                   @id @default(uuid())
  customerId         String
  employeeId       String                   @unique
  isEnabled        Boolean                  @default(true)
  trackingMode     TrackingMode             @default(ATTENDANCE_ONLY)
  permissionStatus LocationPermissionStatus @default(GRANTED)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([employeeId])
}

// ----------------------------------------------------
// HRM & PAYROLL MODELS
// ----------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  REMOTE
  LEAVE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  CALCULATED
  PENDING_APPROVAL
  APPROVED
  GENERATED
  PAID
  FAILED
  CANCELLED
}

enum StructureStatus {
  ACTIVE
  INACTIVE
}

model Department {
  id          String   @id @default(uuid())
  customerId    String
  name        String
  code        String
  description String?
  headId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  designations Designation[]
  employees    Employee[]

  @@unique([customerId, code])
  @@index([customerId])
}

model Designation {
  id           String   @id @default(uuid())
  customerId     String
  departmentId String?
  name         String
  code         String
  description  String?
  level        Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])
  employees  Employee[]

  @@unique([customerId, code])
  @@index([customerId])
}

model Employee {
  id               String   @id @default(uuid())
  customerId         String
  userId           String?  @unique
  employeeCode     String
  firstName        String
  lastName         String
  email            String
  phone            String?
  gender           String?
  dob              DateTime?
  joiningDate      DateTime @default(now())
  departmentId     String?
  designationId    String?
  managerId        String?
  employmentType   String   @default("FULL_TIME")
  branch           String   @default("Head Office")
  address          String?
  emergencyContact String?
  bankDetails      Json?
  documents        Json?
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id])
  department       Department?       @relation(fields: [departmentId], references: [id])
  designation      Designation?      @relation(fields: [designationId], references: [id])
  attendances      Attendance[]
  leaveRequests    LeaveRequest[]
  remoteRequests   RemoteRequest[]
  visits           Visit[]
  salaryStructures SalaryStructure[]
  payrollItems     PayrollItem[]
  salarySlips      SalarySlip[]

  @@unique([customerId, employeeCode])
  @@index([customerId])
  @@index([email])
}

model Attendance {
  id            String           @id @default(uuid())
  customerId      String
  employeeId    String
  date          DateTime         @default(now())
  punchIn       DateTime?
  punchOut      DateTime?
  workingHours  Float            @default(0.0)
  breakDuration Float            @default(0.0)
  status        AttendanceStatus @default(PRESENT)
  locationIn    String?
  locationOut   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  breaks   AttendanceBreak[]

  @@index([customerId])
  @@index([employeeId])
  @@index([date])
}

model AttendanceBreak {
  id           String    @id @default(uuid())
  attendanceId String
  breakStart   DateTime  @default(now())
  breakEnd     DateTime?
  duration     Float     @default(0.0) // in minutes

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
}

model LeaveType {
  id                 String   @id @default(uuid())
  customerId           String
  name               String
  code               String
  daysAllowedPerYear Int      @default(12)
  isCarryForward     Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  leaveRequests LeaveRequest[]

  @@unique([customerId, code])
  @@index([customerId])
}

model LeaveRequest {
  id              String        @id @default(uuid())
  customerId        String
  employeeId      String
  leaveTypeId     String
  fromDate        DateTime
  toDate          DateTime
  days            Int           @default(1)
  reason          String?
  attachmentUrl   String?
  status          RequestStatus @default(PENDING)
  rejectionReason String?
  approvedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([customerId])
  @@index([employeeId])
}

model RemoteRequest {
  id              String        @id @default(uuid())
  customerId        String
  employeeId      String
  fromDate        DateTime
  toDate          DateTime
  days            Int           @default(1)
  reason          String?
  attachmentUrl   String?
  status          RequestStatus @default(PENDING)
  rejectionReason String?
  approvedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([employeeId])
}

model Visit {
  id           String      @id @default(uuid())
  customerId     String
  employeeId   String
  leadId       String?
  customerName String
  purpose      String
  date         DateTime    @default(now())
  time         String?
  location     String
  latitude     Float?
  longitude    Float?
  status       VisitStatus @default(SCHEDULED)
  notes        String?
  duration     Float? // in minutes
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id])

  @@index([customerId])
  @@index([employeeId])
  @@index([leadId])
}

model SalaryStructure {
  id               String          @id @default(uuid())
  customerId         String
  employeeId       String
  basicSalary      Float
  hra              Float           @default(0.0)
  allowances       Float           @default(0.0)
  specialAllowance Float           @default(0.0)
  bonus            Float           @default(0.0)
  commission       Float           @default(0.0)
  overtime         Float           @default(0.0)
  otherEarnings    Float           @default(0.0)
  pf               Float           @default(0.0)
  esi              Float           @default(0.0)
  professionalTax  Float           @default(0.0)
  tds              Float           @default(0.0)
  otherDeductions  Float           @default(0.0)
  grossSalary      Float
  totalDeductions  Float
  netSalary        Float
  effectiveFrom    DateTime        @default(now())
  effectiveTo      DateTime?
  status           StructureStatus @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([employeeId])
}

model Payroll {
  id              String        @id @default(uuid())
  customerId        String
  month           Int
  year            Int
  departmentId    String?
  status          PayrollStatus @default(DRAFT)
  grossSalary     Float         @default(0.0)
  totalDeductions Float         @default(0.0)
  netSalary       Float         @default(0.0)
  totalEmployees  Int           @default(0)
  processedAt     DateTime?
  approvedAt      DateTime?
  disbursedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items  PayrollItem[]

  @@unique([customerId, month, year, departmentId])
  @@index([customerId])
}

model PayrollItem {
  id               String   @id @default(uuid())
  payrollId        String
  customerId         String
  employeeId       String
  basicSalary      Float
  hra              Float    @default(0.0)
  allowances       Float    @default(0.0)
  specialAllowance Float    @default(0.0)
  bonus            Float    @default(0.0)
  commission       Float    @default(0.0)
  overtime         Float    @default(0.0)
  otherEarnings    Float    @default(0.0)
  pf               Float    @default(0.0)
  esi              Float    @default(0.0)
  professionalTax  Float    @default(0.0)
  tds              Float    @default(0.0)
  otherDeductions  Float    @default(0.0)
  grossSalary      Float
  totalDeductions  Float
  netSalary        Float
  workingDays      Int      @default(30)
  presentDays      Int      @default(30)
  absentDays       Int      @default(0)
  halfDays         Int      @default(0)
  paidLeaveDays    Int      @default(0)
  unpaidLeaveDays  Int      @default(0)
  wfhDays          Int      @default(0)
  status           String   @default("GENERATED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payroll     Payroll      @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salarySlips SalarySlip[]

  @@index([payrollId])
  @@index([customerId])
  @@index([employeeId])
}

model SalarySlip {
  id              String   @id @default(uuid())
  customerId        String
  payrollItemId   String
  employeeId      String
  slipNumber      String   @unique
  payPeriod       String
  grossSalary     Float
  totalDeductions Float
  netSalary       Float
  pdfUrl          String?
  generatedAt     DateTime @default(now())
  status          String   @default("GENERATED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payrollItem PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([employeeId])
}

model PayrollPolicy {
  id                  String   @id @default(uuid())
  customerId            String   @unique
  workingDaysPerMonth Int      @default(30)
  lateDeductionRate   Float    @default(0.0)
  overtimeMultiplier  Float    @default(1.5)
  pfPercent           Float    @default(12.0)
  esiPercent          Float    @default(0.75)
  taxExemptionLimit   Float    @default(300000)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

