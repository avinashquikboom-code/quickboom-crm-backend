generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plan {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  code             String            @unique
  description      String?
  monthlyPrice     Float
  yearlyPrice      Float
  userLimit        Int
  storageLimit     BigInt
  features         Json
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  taxRateBps       Int @default(1800)
  yearlyDiscountBps Int @default(2000)
  billingIntervals String[] @default(["MONTHLY", "YEARLY"])
  isRecommended Boolean @default(false)
  customerSubscriptions CustomerSubscription[]
  checkouts CustomerCheckout[]
  monthlySchedules MonthlySchedule[]
  commissions      Commission[]
  couponPlans      CouponPlan[]

  @@index([deletedAt])
}

model Coupon {
  id                    Int              @id @default(autoincrement())
  code                  String           @unique
  name                  String?
  description           String?
  discountPct           Float
  discountType          String           @default("PERCENTAGE")
  discountValue         Float?
  minimumAmount         Float?
  maximumDiscountAmount Float?
  startsAt              DateTime?
  maxRedemptions        Int              @default(100)
  timesRedeemed         Int              @default(0)
  appliesToAllPlans     Boolean          @default(true)
  expiresAt             DateTime?
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?
  plans                 CouponPlan[]
  payments              PaymentHistory[]

  @@index([code])
  @@index([deletedAt])
}

model CouponPlan {
  couponId Int
  planId   Int
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([couponId, planId])
  @@map("coupon_plans")
}

model PaymentHistory {
  id             Int                       @id @default(autoincrement())
  amount         Float
  currency       String                    @default("INR")
  paymentMethod  PaymentMethod             @default(RAZORPAY)
  paymentId      String?
  orderId        String?
  status         String
  invoiceUrl     String?
  orderNumber    String?
  planId         Int?
  planName       String?
  billingCycle   SubscriptionBillingCycle?
  taxAmount      Float?
  totalAmount    Float?
  transactionId  String?
  couponId       Int?
  couponCode     String?
  originalAmount Float?
  discountAmount Float?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  deletedAt      DateTime?
  coupon         Coupon?                   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  commission     Commission?

  @@index([deletedAt])
}

model User {
  customerAccount Customer?
  createdLeads            Lead[]            @relation("LeadCreator")
  accountType             String            @default("EMPLOYEE")
  id                      Int               @id @default(autoincrement())
  email                   String            @unique
  phone                   String?           @unique
  passwordHash            String
  firstName               String
  lastName                String
  avatar                  String?
  designation             String?
  isActive                Boolean           @default(true)
  isVerified              Boolean           @default(false)
  isPhoneVerified         Boolean           @default(false)
  otpCode                 String?
  otpExpiresAt            DateTime?
  otpAttempts             Int               @default(0)
  otpLastSentAt           DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  deletedAt               DateTime?
  auditLogs               AuditLog[]
  assignedContacts        Contact[]         @relation("AssignedContacts")
  dataCaptureJobs         DataCaptureJob[]
  assignedDeals           Deal[]            @relation("AssignedDeals")
  employee                Employee?
  notifications           Notification[]
  refreshTokens           RefreshToken[]
  sessions                Session[]
  assignedTickets         SupportTicket[]   @relation("AssignedTickets")
  createdTickets          SupportTicket[]   @relation("CreatedTickets")
  assignedTasks           Task[]            @relation("AssignedTasks")
  createdTasks            Task[]            @relation("CreatedTasks")
  ticketComments          TicketComment[]
  deviceTokens            UserDeviceToken[]
  createdTrendingContents TrendingContent[] @relation("CreatedTrendingContents")
  createdMarketingBanners MarketingBanner[] @relation("CreatedMarketingBanners")
  createdMarketingVideos  MarketingVideo[]  @relation("CreatedMarketingVideos")
  emailLogs               EmailLog[]

  @@index([email])
  @@index([phone])
  @@index([deletedAt])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  ipAddress String?
  userAgent String?
  device    String?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id            Int       @id @default(autoincrement())
  name          String
  domain        String?
  industry      String?
  phone         String?
  email         String?
  address       String?
  city          String?
  country       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  category      String?
  googlePlaceId String?
  latitude      Float?
  longitude     Float?
  notes         String?
  postalCode    String?
  rating        Float?
  reviewCount   Int?
  source        String?   @default("MANUAL")
  state         String?
  status        String?   @default("ACTIVE")
  website       String?
  contacts      Contact[]
  deals         Deal[]
  visits        Visit[]

  @@index([googlePlaceId])
  @@index([deletedAt])
}

model Contact {
  id              Int                    @id @default(autoincrement())
  companyId       Int?
  type            ContactType            @default(CUSTOMER)
  firstName       String
  lastName        String
  email           String?
  phone           String?
  designation     String?
  tags            String[]
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?
  alternateMobile String?
  assignedToId    Int?
  mobile          String?
  source          String?                @default("DIRECT")
  status          String?                @default("ACTIVE")
  website         String?
  communications  CommunicationHistory[]
  assignedTo      User?                  @relation("AssignedContacts", fields: [assignedToId], references: [id])
  company         Company?               @relation(fields: [companyId], references: [id])
  deals           Deal[]
  invoices        Invoice[]
  quotations      Quotation[]
  visits          Visit[]

  @@index([companyId])
  @@index([deletedAt])
}

model CommunicationHistory {
  id        Int      @id @default(autoincrement())
  contactId Int
  type      String
  summary   String
  details   String?
  timestamp DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model Pipeline {
  id        Int             @id @default(autoincrement())
  name      String
  isDefault Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  deals     Deal[]
  stages    PipelineStage[]

  @@index([deletedAt])
}

model PipelineStage {
  id          Int      @id @default(autoincrement())
  pipelineId  Int
  name        String
  order       Int
  probability Float    @default(50.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deals       Deal[]
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([pipelineId])
}

model Deal {
  id              Int           @id @default(autoincrement())
  pipelineId      Int
  stageId         Int
  contactId       Int?
  companyId       Int?
  title           String
  amount          Float
  expectedClosing DateTime?
  probability     Float         @default(50.0)
  isWon           Boolean       @default(false)
  isLost          Boolean       @default(false)
  lostReason      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  assignedToId    Int?
  currency        String?       @default("INR")
  description     String?
  notes           String?
  source          String?       @default("CRM")
  assignedTo      User?         @relation("AssignedDeals", fields: [assignedToId], references: [id])
  company         Company?      @relation(fields: [companyId], references: [id])
  contact         Contact?      @relation(fields: [contactId], references: [id])
  pipeline        Pipeline      @relation(fields: [pipelineId], references: [id])
  stage           PipelineStage @relation(fields: [stageId], references: [id])
  quotations      Quotation[]
  visits          Visit[]

  @@index([pipelineId])
  @@index([stageId])
  @@index([deletedAt])
}

model Task {
  id                Int           @id @default(autoincrement())
  title             String
  description       String?
  status            TaskStatus    @default(PENDING)
  priority          TaskPriority  @default(MEDIUM)
  dueDate           DateTime?
  isRecurring       Boolean       @default(false)
  recurrence        String?
  assignedToId      Int?
  createdById       Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  approvedAt        DateTime?
  approvedById      Int?
  approvedByName    String?
  category          String?
  departmentId      Int?
  designationId     Int?
  dueAt             DateTime?
  dueTime           String?
  employeeId        Int?
  notes             String?
  rejectedAt        DateTime?
  rejectedById      Int?
  rejectedByName    String?
  rejectionReason   String?
  startDate         DateTime?
  startTime         String?
  submissionComment String?
  submittedAt       DateTime?
  taskNumber        String?
  completedAt       DateTime?
  startedAt         DateTime?
  assignedTo        User?         @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdBy         User          @relation("CreatedTasks", fields: [createdById], references: [id])
  department        Department?   @relation(fields: [departmentId], references: [id])
  designation       Designation?  @relation(fields: [designationId], references: [id])
  employee          Employee?     @relation(fields: [employeeId], references: [id])
  history           TaskHistory[]
  proofs            TaskProof[]
  reviews           TaskReview[]

  @@index([employeeId])
  @@index([departmentId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueAt])
  @@index([deletedAt])
  @@index([deletedAt, createdAt])
  @@index([assignedToId, status, deletedAt])
}

model TaskProof {
  id         Int      @id @default(autoincrement())
  taskId     Int
  employeeId Int?
  fileUrl    String
  fileName   String?
  fileType   String?
  fileSize   Int?
  comment    String?
  uploadedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([employeeId])
}

model TaskReview {
  id             Int      @id @default(autoincrement())
  taskId         Int
  reviewedById   Int
  reviewedByName String?
  status         String
  comment        String?
  reviewedAt     DateTime @default(now())
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskHistory {
  id                   Int      @id @default(autoincrement())
  taskId               Int
  action               String
  performedById        Int?
  performedByName      String?
  oldStatus            String?
  newStatus            String?
  previousEmployeeId   Int?
  previousEmployeeName String?
  newEmployeeId        Int?
  newEmployeeName      String?
  comment              String?
  createdAt            DateTime @default(now())
  task                 Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Product {
  id             Int             @id @default(autoincrement())
  name           String
  sku            String
  description    String?
  unitPrice      Float
  currency       String          @default("INR")
  taxRate        Float           @default(18.0)
  stock          Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  invoiceItems   InvoiceItem[]
  quotationItems QuotationItem[]

  @@unique([sku])
  @@index([deletedAt])
}

model Quotation {
  id          Int             @id @default(autoincrement())
  contactId   Int?
  dealId      Int?
  quotationNo String
  status      QuotationStatus @default(DRAFT)
  subTotal    Float
  taxAmount   Float
  discount    Float           @default(0)
  totalAmount Float
  validUntil  DateTime
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  invoices    Invoice[]
  contact     Contact?        @relation(fields: [contactId], references: [id])
  deal        Deal?           @relation(fields: [dealId], references: [id])
  items       QuotationItem[]

  @@index([contactId])
  @@index([deletedAt])
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  quotationId Int
  productId   Int
  quantity    Int
  unitPrice   Float
  total       Float
  product     Product   @relation(fields: [productId], references: [id])
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model Invoice {
  id          Int           @id @default(autoincrement())
  contactId   Int
  quotationId Int?
  invoiceNo   String
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime
  dueDate     DateTime
  subTotal    Float
  taxAmount   Float
  discount    Float         @default(0)
  totalAmount Float
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  contact     Contact       @relation(fields: [contactId], references: [id])
  quotation   Quotation?    @relation(fields: [quotationId], references: [id])
  items       InvoiceItem[]

  @@index([contactId])
  @@index([status])
  @@index([deletedAt])
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  productId Int
  quantity  Int
  unitPrice Float
  total     Float
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model SupportTicket {
  id           Int             @id @default(autoincrement())
  ticketNo     String
  subject      String
  description  String
  status       TicketStatus    @default(OPEN)
  priority     TicketPriority  @default(MEDIUM)
  assignedToId Int?
  createdById  Int
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  assignedTo   User?           @relation("AssignedTickets", fields: [assignedToId], references: [id])
  createdBy    User            @relation("CreatedTickets", fields: [createdById], references: [id])
  comments     TicketComment[]

  @@index([status])
  @@index([deletedAt])
}

model TicketComment {
  id        Int           @id @default(autoincrement())
  ticketId  Int
  userId    Int
  comment   String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  @@index([ticketId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([userId, isRead, createdAt])
  @@index([createdAt])
}

model NotificationCampaign {
  id               Int       @id @default(autoincrement())
  title            String
  message          String
  notificationType String    @default("OFFER")
  targetType       String // "EMPLOYEES"
  audience         String // "ALL" | "SPECIFIC"
  targetIds        Json? // Array of target IDs when audience is SPECIFIC
  imageUrl         String?
  showCta          Boolean   @default(false)
  ctaText          String?
  ctaActionType    String? // "DEEP_LINK" | "WEB_URL"
  ctaActionValue   String?
  scheduledAt      DateTime?
  status           String    @default("SENT") // "SENT" | "SCHEDULED" | "FAILED"
  recipientCount   Int       @default(0)
  sentCount        Int       @default(0)
  failedCount      Int       @default(0)
  createdById      Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([createdAt])
}

model UserDeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  platform  String   @default("ANDROID")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([token])
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  userId       Int?
  userName     String?
  userRole     String? // CUSTOMER, EMPLOYEE, ADMIN, SUPER_ADMIN
  source       String   @default("ADMIN_PANEL") // ADMIN_PANEL, MOBILE_APP
  action       String // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, APPROVE, REJECT, SUBMIT, etc.
  module       String // Attendance, Leave, Remote Work, Influencers, CRM, Settings, Payroll, etc.
  description  String?
  entityType   String?
  entityId     String?
  endpoint     String?
  method       String? // POST, PUT, PATCH, DELETE, GET
  ipAddress    String?
  device       String?
  status       String   @default("SUCCESS") // SUCCESS, FAILED
  errorMessage String?
  details      Json?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([source])
  @@index([userRole])
  @@index([module])
  @@index([action])
  @@index([status])
  @@index([entityType, entityId])
}

model FeatureToggle {
  id        Int      @id @default(autoincrement())
  feature   String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([feature])
}

model EmployeeLocation {
  id                 Int          @id @default(autoincrement())
  employeeId         Int
  latitude           Float
  longitude          Float
  accuracy           Float?
  address            String?
  distanceFromOffice Float?
  locationStatus     String?
  trackingType       TrackingType @default(ATTENDANCE)
  attendanceId       Int?
  visitId            Int?
  timestamp          DateTime     @default(now())
  createdAt          DateTime     @default(now())
  employee           Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([timestamp])
  @@index([employeeId, timestamp])
}

model BranchGeofence {
  id                 Int                @id @default(autoincrement())
  name               String
  code               String?
  address            String?
  city               String?
  state              String?
  country            String?            @default("India")
  postalCode         String?
  latitude           Float
  longitude          Float
  radiusMeters       Float              @default(200.0)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  attendances        Attendance[]
  attendancePolicies AttendancePolicy[]
  claimPolicies      ClaimPolicy[]
  employees          Employee[]
  leavePolicies      LeavePolicy[]
  publicHolidays     PublicHoliday[]
  salaryPolicies     SalaryPolicy[]

  @@index([isActive])
}

model LocationTrackingSetting {
  id               Int                      @id @default(autoincrement())
  employeeId       Int                      @unique
  isEnabled        Boolean                  @default(true)
  trackingMode     TrackingMode             @default(ATTENDANCE_ONLY)
  permissionStatus LocationPermissionStatus @default(GRANTED)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([employeeId])
}

model Department {
  id           Int           @id @default(autoincrement())
  name         String
  code         String
  description  String?
  headId       Int?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  designations Designation[]
  employees    Employee[]
  tasks        Task[]

  @@unique([code])
}

model Designation {
  id                Int                 @id @default(autoincrement())
  departmentId      Int?
  name              String
  code              String
  description       String?
  level             Int                 @default(1)
  isActive          Boolean             @default(true)
  crmMobileAccess   Boolean             @default(false)
  commissionEnabled Boolean             @default(false)
  commissionType    CommissionType      @default(PERCENTAGE)
  commissionRate    Float               @default(0.0)
  audience          DesignationAudience @default(EMPLOYEE)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  department        Department?         @relation(fields: [departmentId], references: [id])
  employees         Employee[]
  tasks             Task[]

  @@unique([code])
}

model Employee {
  assignedLeads            Lead[]                   @relation("LeadAssignee")
  id                       Int                      @id @default(autoincrement())
  userId                   Int?                     @unique
  employeeCode             String
  firstName                String
  lastName                 String
  email                    String
  phone                    String?
  gender                   String?
  dob                      DateTime?
  joiningDate              DateTime                 @default(now())
  departmentId             Int?
  designationId            Int?
  managerId                Int?
  employmentType           String                   @default("FULL_TIME")
  employeeType             EmployeeType             @default(COMPANY)
  city                     String?
  branch                   String                   @default("Head Office")
  address                  String?
  emergencyContact         String?
  bankDetails              Json?
  documents                Json?
  status                   String                   @default("ACTIVE")
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  mobileLoginEnabled       Boolean                  @default(true)
  officeId                 Int?
  shiftId                  Int?
  attendances              Attendance[]
  department               Department?              @relation(fields: [departmentId], references: [id])
  designation              Designation?             @relation(fields: [designationId], references: [id])
  office                   BranchGeofence?          @relation(fields: [officeId], references: [id])
  shift                    Shift?                   @relation(fields: [shiftId], references: [id])
  user                     User?                    @relation(fields: [userId], references: [id])
  employeeClaims           EmployeeClaim[]
  dataCaptureSearches      DataCaptureSearch[]
  leaveBalances            EmployeeLeaveBalance[]
  employeeLoans            EmployeeLoan[]
  employeeLocations        EmployeeLocation[]
  leaveAdjustments         LeaveAdjustmentHistory[]
  leaveRequests            LeaveRequest[]
  payrollItems             PayrollItem[]
  remoteRequests           RemoteRequest[]
  salarySlips              SalarySlip[]
  salaryStructures         SalaryStructure[]
  tasks                    Task[]
  teamMembers              TeamMember[]
  visits                   Visit[]
  works                    Work[]                   @relation("AssignedEmployeeWorks")
  editedWorks              Work[]                   @relation("AssignedEditorWorks")
  workTasks                WorkTask[]
  assignedMonthlySchedules MonthlySchedule[]
  workAccessRequests       WorkAccessRequest[]
  ledTeams                 Team[]                   @relation("TeamLeader")
  commissionConfig         CommissionConfig?
  commissions              Commission[]
  commissionShares         CommissionShare[]

  @@unique([employeeCode])
  @@index([email])
  @@index([officeId])
}

model Attendance {
  id                        Int               @id @default(autoincrement())
  employeeId                Int
  date                      DateTime          @default(now())
  punchIn                   DateTime?
  punchOut                  DateTime?
  workingHours              Float             @default(0.0)
  workingMinutes            Int?              @default(0)
  breakDuration             Float             @default(0.0)
  lateMinutes               Int?              @default(0)
  isLate                    Boolean?          @default(false)
  workMode                  String?           @default("OFFICE")
  locationStatus            String?           @default("INSIDE_RADIUS")
  status                    AttendanceStatus  @default(PRESENT)
  locationIn                String?
  locationOut               String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  distanceFromOffice        Float?
  latitude                  Float?
  longitude                 Float?
  accuracy                  Float?
  punchOutLatitude          Float?
  punchOutLongitude         Float?
  punchOutAccuracy          Float?
  officeId                  Int?
  punchInBiometricVerified  Boolean?          @default(false)
  punchOutBiometricVerified Boolean?          @default(false)
  employee                  Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  office                    BranchGeofence?   @relation(fields: [officeId], references: [id])
  breaks                    AttendanceBreak[]

  @@index([employeeId])
  @@index([officeId])
  @@index([date])
  @@index([status])
  @@index([workMode])
  @@index([employeeId, date])
}

