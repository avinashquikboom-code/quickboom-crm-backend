generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id                       Int                       @id @default(autoincrement())
  name                     String
  domain                   String?                   @unique
  logo                     String?
  phone                    String?
  email                    String?
  address                  String?
  city                     String?
  state                    String?
  country                  String?
  isActive                 Boolean                   @default(true)
  storageUsed              BigInt                    @default(0)
  userLimit                Int                       @default(5)
  leadLimit                Int                       @default(500)
  storageLimit             BigInt                    @default(5368709120)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  pincode                  String?
  companyName              String?
  alternatePhone           String?
  customerType             String?                   @default("ENTERPRISE")
  industry                 String?
  source                   String?                   @default("DIRECT")
  assignedEmployee         String?
  department               String?
  notes                    String?
  attendancePolicies       AttendancePolicy[]
  auditLogs                AuditLog[]
  branchGeofences          BranchGeofence[]
  claimPolicies            ClaimPolicy[]
  companies                Company[]
  contacts                 Contact[]
  dataCaptureJobs          DataCaptureJob[]
  dataCapturePlaces        DataCapturePlace[]
  deals                    Deal[]
  departments              Department[]
  designations             Designation[]
  employees                Employee[]
  employeeClaims           EmployeeClaim[]
  leaveBalances            EmployeeLeaveBalance[]
  employeeLoans            EmployeeLoan[]
  employeeLocations        EmployeeLocation[]
  featureToggles           FeatureToggle[]
  invoices                 Invoice[]
  leads                    Lead[]
  leaveAdjustments         LeaveAdjustmentHistory[]
  leavePolicies            LeavePolicy[]
  locationTrackingSettings LocationTrackingSetting[]
  notifications            Notification[]
  payments                 PaymentHistory[]
  payrolls                 Payroll[]
  payrollPolicy            PayrollPolicy?
  pipelines                Pipeline[]
  planEntitlements         PlanEntitlement[]
  products                 Product[]
  publicHolidays           PublicHoliday[]
  quotations               Quotation[]
  roles                    Role[]
  salaryPolicies           SalaryPolicy[]
  shifts                   Shift[]
  shiftGuidances           ShiftGuidance[]
  tickets                  SupportTicket[]
  tasks                    Task[]
  teams                    Team[]
  users                    User[]
  works                    Work[]
  subscriptions            CustomerSubscription[]
  monthlySchedules         MonthlySchedule[]
  customPlanOrders         CustomPlanOrder[]
  installments             SubscriptionInstallment[]
  trendingContents         TrendingContent[]
  marketingBanners         MarketingBanner[]
  socialMediaHandlers      SocialMediaHandler[]

  @@index([deletedAt])
  @@index([isActive])
  @@map("customers")
}

model Plan {
  id               Int                    @id @default(autoincrement())
  name             String                 @unique
  code             String                 @unique
  description      String?
  monthlyPrice     Float
  yearlyPrice      Float
  userLimit        Int
  leadLimit        Int
  storageLimit     BigInt
  features         Json
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?
  subscriptions    CustomerSubscription[]
  monthlySchedules MonthlySchedule[]

  @@index([deletedAt])
}

model CustomerSubscription {
  id                 Int                       @id @default(autoincrement())
  customerId         Int
  planId             Int
  status             SubscriptionStatus        @default(TRIAL)
  billingCycle       SubscriptionBillingCycle  @default(MONTHLY)
  startDate          DateTime
  endDate            DateTime
  duration           Int                       @default(1)
  durationUnit       String                    @default("MONTH")
  trialEndsAt        DateTime?
  autoRenew          Boolean                   @default(true)
  couponId           Int?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  deletedAt          DateTime?
  customFeatures     Json?
  customLeadLimit    Int?
  customPrice        Float?
  customStorageLimit BigInt?
  customUserLimit    Int?
  payments           PaymentHistory[]
  monthlySchedules   MonthlySchedule[]
  customPlanOrders   CustomPlanOrder[]
  works              Work[]
  installments       SubscriptionInstallment[]
  coupon             Coupon?                   @relation(fields: [couponId], references: [id])
  customer           Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan               Plan                      @relation(fields: [planId], references: [id])

  @@index([customerId])
  @@index([planId])
  @@index([status])
  @@index([deletedAt])
  @@map("customer_subscriptions")
}

model Coupon {
  id             Int                    @id @default(autoincrement())
  code           String                 @unique
  discountPct    Float
  maxRedemptions Int                    @default(100)
  timesRedeemed  Int                    @default(0)
  expiresAt      DateTime?
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?
  subscriptions  CustomerSubscription[]

  @@index([code])
}

model PaymentHistory {
  id             Int                       @id @default(autoincrement())
  customerId     Int
  subscriptionId Int?
  amount         Float
  currency       String                    @default("INR")
  paymentMethod  PaymentMethod             @default(RAZORPAY)
  paymentId      String?
  orderId        String?
  status         String
  invoiceUrl     String?
  orderNumber    String?
  planId         Int?
  planName       String?
  billingCycle   SubscriptionBillingCycle?
  taxAmount      Float?
  totalAmount    Float?
  transactionId  String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  deletedAt      DateTime?
  customer       Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscription   CustomerSubscription?     @relation(fields: [subscriptionId], references: [id])
  installments   SubscriptionInstallment[]

  @@index([customerId])
  @@index([deletedAt])
}

model User {
  id                      Int               @id @default(autoincrement())
  customerId              Int?
  email                   String            @unique
  phone                   String?           @unique
  passwordHash            String
  firstName               String
  lastName                String
  avatar                  String?
  designation             String?
  isActive                Boolean           @default(true)
  isVerified              Boolean           @default(false)
  isPhoneVerified         Boolean           @default(false)
  otpCode                 String?
  otpExpiresAt            DateTime?
  otpAttempts             Int               @default(0)
  otpLastSentAt           DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  deletedAt               DateTime?
  auditLogs               AuditLog[]
  assignedContacts        Contact[]         @relation("AssignedContacts")
  dataCaptureJobs         DataCaptureJob[]
  assignedDeals           Deal[]            @relation("AssignedDeals")
  employee                Employee?
  assignedLeads           Lead[]            @relation("AssignedLeads")
  createdLeads            Lead[]            @relation("CreatedLeads")
  leadNotes               LeadNote[]
  notifications           Notification[]
  refreshTokens           RefreshToken[]
  sessions                Session[]
  assignedTickets         SupportTicket[]   @relation("AssignedTickets")
  createdTickets          SupportTicket[]   @relation("CreatedTickets")
  assignedTasks           Task[]            @relation("AssignedTasks")
  createdTasks            Task[]            @relation("CreatedTasks")
  ticketComments          TicketComment[]
  customer                Customer?         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userRoles               UserRole[]
  deviceTokens            UserDeviceToken[]
  createdTrendingContents TrendingContent[] @relation("CreatedTrendingContents")
  createdMarketingBanners MarketingBanner[] @relation("CreatedMarketingBanners")

  @@index([customerId])
  @@index([email])
  @@index([phone])
  @@index([deletedAt])
}

model Role {
  id              Int              @id @default(autoincrement())
  customerId      Int?
  name            String
  type            RoleType         @default(CUSTOM)
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([customerId])
  @@index([deletedAt])
}

model Permission {
  id              Int              @id @default(autoincrement())
  module          String
  action          String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@unique([module, action])
}

model UserRole {
  userId Int
  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  ipAddress String?
  userAgent String?
  device    String?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Lead {
  id                   Int                    @id @default(autoincrement())
  customerId           Int
  title                String
  firstName            String
  lastName             String
  email                String?
  phone                String?
  companyName          String?
  website              String?
  address              String?
  city                 String?
  state                String?
  category             String?
  source               String                 @default("WEBSITE")
  status               LeadStatus             @default(NEW)
  priority             LeadPriority           @default(MEDIUM)
  value                Float                  @default(0)
  assignedToId         Int?
  createdById          Int
  nextFollowUpDate     DateTime?
  nextFollowUpTime     String?
  workStartDate        DateTime?
  workNotes            String?
  assignedTeam         String?
  paidAmount           Float?                 @default(0)
  paymentStatus        String?                @default("PENDING")
  paymentMethod        String?
  paymentRef           String?
  convertedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  convertedToCompanyId Int?
  convertedToContactId Int?
  convertedToDealId    Int?
  country              String?
  googlePlaceId        String?
  latitude             Float?
  longitude            Float?
  rating               Float?
  reviewCount          Int?
  assignedTo           User?                  @relation("AssignedLeads", fields: [assignedToId], references: [id])
  createdBy            User                   @relation("CreatedLeads", fields: [createdById], references: [id])
  customer             Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  timeline             LeadActivityTimeline[]
  notes                LeadNote[]
  reminders            LeadReminder[]
  statusHistory        LeadStatusHistory[]
  quotations           Quotation[]
  visits               Visit[]

  @@index([customerId])
  @@index([status])
  @@index([assignedToId])
  @@index([googlePlaceId])
  @@index([deletedAt])
  @@index([customerId, deletedAt, createdAt])
  @@index([customerId, status, deletedAt])
}

model LeadStatusHistory {
  id          Int         @id @default(autoincrement())
  leadId      Int
  fromStatus  LeadStatus?
  toStatus    LeadStatus
  changedById Int?
  notes       String?
  createdAt   DateTime    @default(now())
  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadNote {
  id        Int      @id @default(autoincrement())
  leadId    Int
  userId    Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([leadId])
}

model LeadActivityTimeline {
  id          Int      @id @default(autoincrement())
  leadId      Int
  action      String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadReminder {
  id          Int      @id @default(autoincrement())
  leadId      Int
  remindAt    DateTime
  title       String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Company {
  id            Int       @id @default(autoincrement())
  customerId    Int
  name          String
  domain        String?
  industry      String?
  phone         String?
  email         String?
  address       String?
  city          String?
  country       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  category      String?
  googlePlaceId String?
  latitude      Float?
  longitude     Float?
  notes         String?
  postalCode    String?
  rating        Float?
  reviewCount   Int?
  source        String?   @default("MANUAL")
  state         String?
  status        String?   @default("ACTIVE")
  website       String?
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  deals         Deal[]
  visits        Visit[]

  @@index([customerId])
  @@index([googlePlaceId])
  @@index([deletedAt])
}

model Contact {
  id              Int                    @id @default(autoincrement())
  customerId      Int
  companyId       Int?
  type            ContactType            @default(CUSTOMER)
  firstName       String
  lastName        String
  email           String?
  phone           String?
  designation     String?
  tags            String[]
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?
  alternateMobile String?
  assignedToId    Int?
  mobile          String?
  source          String?                @default("DIRECT")
  status          String?                @default("ACTIVE")
  website         String?
  communications  CommunicationHistory[]
  assignedTo      User?                  @relation("AssignedContacts", fields: [assignedToId], references: [id])
  company         Company?               @relation(fields: [companyId], references: [id])
  customer        Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deals           Deal[]
  invoices        Invoice[]
  quotations      Quotation[]
  visits          Visit[]

  @@index([customerId])
  @@index([companyId])
  @@index([deletedAt])
}

model CommunicationHistory {
  id        Int      @id @default(autoincrement())
  contactId Int
  type      String
  summary   String
  details   String?
  timestamp DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

model Pipeline {
  id         Int             @id @default(autoincrement())
  customerId Int
  name       String
  isDefault  Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?
  deals      Deal[]
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stages     PipelineStage[]

  @@index([customerId])
  @@index([deletedAt])
}

model PipelineStage {
  id          Int      @id @default(autoincrement())
  pipelineId  Int
  name        String
  order       Int
  probability Float    @default(50.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deals       Deal[]
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([pipelineId])
}

model Deal {
  id              Int           @id @default(autoincrement())
  customerId      Int
  pipelineId      Int
  stageId         Int
  contactId       Int?
  companyId       Int?
  title           String
  amount          Float
  expectedClosing DateTime?
  probability     Float         @default(50.0)
  isWon           Boolean       @default(false)
  isLost          Boolean       @default(false)
  lostReason      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  assignedToId    Int?
  currency        String?       @default("INR")
  description     String?
  leadId          Int?
  notes           String?
  source          String?       @default("CRM")
  assignedTo      User?         @relation("AssignedDeals", fields: [assignedToId], references: [id])
  company         Company?      @relation(fields: [companyId], references: [id])
  contact         Contact?      @relation(fields: [contactId], references: [id])
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pipeline        Pipeline      @relation(fields: [pipelineId], references: [id])
  stage           PipelineStage @relation(fields: [stageId], references: [id])
  quotations      Quotation[]
  visits          Visit[]

  @@index([customerId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([deletedAt])
}

model Task {
  id                Int           @id @default(autoincrement())
  customerId        Int
  title             String
  description       String?
  status            TaskStatus    @default(PENDING)
  priority          TaskPriority  @default(MEDIUM)
  dueDate           DateTime?
  isRecurring       Boolean       @default(false)
  recurrence        String?
  assignedToId      Int?
  createdById       Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  approvedAt        DateTime?
  approvedById      Int?
  approvedByName    String?
  category          String?
  departmentId      Int?
  designationId     Int?
  dueAt             DateTime?
  dueTime           String?
  employeeId        Int?
  notes             String?
  rejectedAt        DateTime?
  rejectedById      Int?
  rejectedByName    String?
  rejectionReason   String?
  startDate         DateTime?
  startTime         String?
  submissionComment String?
  submittedAt       DateTime?
  taskNumber        String?
  completedAt       DateTime?
  startedAt         DateTime?
  assignedTo        User?         @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdBy         User          @relation("CreatedTasks", fields: [createdById], references: [id])
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  department        Department?   @relation(fields: [departmentId], references: [id])
  designation       Designation?  @relation(fields: [designationId], references: [id])
  employee          Employee?     @relation(fields: [employeeId], references: [id])
  history           TaskHistory[]
  proofs            TaskProof[]
  reviews           TaskReview[]

  @@index([customerId])
  @@index([employeeId])
  @@index([departmentId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueAt])
  @@index([deletedAt])
  @@index([customerId, deletedAt, createdAt])
  @@index([assignedToId, status, deletedAt])
}

model TaskProof {
  id         Int      @id @default(autoincrement())
  taskId     Int
  employeeId Int?
  fileUrl    String
  fileName   String?
  fileType   String?
  fileSize   Int?
  comment    String?
  uploadedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([employeeId])
}

model TaskReview {
  id             Int      @id @default(autoincrement())
  taskId         Int
  reviewedById   Int
  reviewedByName String?
  status         String
  comment        String?
  reviewedAt     DateTime @default(now())
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskHistory {
  id                   Int      @id @default(autoincrement())
  taskId               Int
  action               String
  performedById        Int?
  performedByName      String?
  oldStatus            String?
  newStatus            String?
  previousEmployeeId   Int?
  previousEmployeeName String?
  newEmployeeId        Int?
  newEmployeeName      String?
  comment              String?
  createdAt            DateTime @default(now())
  task                 Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Product {
  id             Int             @id @default(autoincrement())
  customerId     Int
  name           String
  sku            String
  description    String?
  unitPrice      Float
  currency       String          @default("INR")
  taxRate        Float           @default(18.0)
  stock          Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  invoiceItems   InvoiceItem[]
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotationItems QuotationItem[]

  @@unique([customerId, sku])
  @@index([customerId])
  @@index([deletedAt])
}

model Quotation {
  id          Int             @id @default(autoincrement())
  customerId  Int
  contactId   Int?
  dealId      Int?
  leadId      Int?
  quotationNo String
  status      QuotationStatus @default(DRAFT)
  subTotal    Float
  taxAmount   Float
  discount    Float           @default(0)
  totalAmount Float
  validUntil  DateTime
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  invoices    Invoice[]
  contact     Contact?        @relation(fields: [contactId], references: [id])
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal        Deal?           @relation(fields: [dealId], references: [id])
  lead        Lead?           @relation(fields: [leadId], references: [id])
  items       QuotationItem[]

  @@index([customerId])
  @@index([contactId])
  @@index([leadId])
  @@index([deletedAt])
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  quotationId Int
  productId   Int
  quantity    Int
  unitPrice   Float
  total       Float
  product     Product   @relation(fields: [productId], references: [id])
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model Invoice {
  id           Int                       @id @default(autoincrement())
  customerId   Int
  contactId    Int
  quotationId  Int?
  invoiceNo    String
  status       InvoiceStatus             @default(DRAFT)
  issueDate    DateTime
  dueDate      DateTime
  subTotal     Float
  taxAmount    Float
  discount     Float                     @default(0)
  totalAmount  Float
  notes        String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  deletedAt    DateTime?
  contact      Contact                   @relation(fields: [contactId], references: [id])
  customer     Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotation    Quotation?                @relation(fields: [quotationId], references: [id])
  items        InvoiceItem[]
  installments SubscriptionInstallment[]

  @@index([customerId])
  @@index([contactId])
  @@index([status])
  @@index([deletedAt])
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  productId Int
  quantity  Int
  unitPrice Float
  total     Float
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model SupportTicket {
  id           Int             @id @default(autoincrement())
  customerId   Int
  ticketNo     String
  subject      String
  description  String
  status       TicketStatus    @default(OPEN)
  priority     TicketPriority  @default(MEDIUM)
  assignedToId Int?
  createdById  Int
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  assignedTo   User?           @relation("AssignedTickets", fields: [assignedToId], references: [id])
  createdBy    User            @relation("CreatedTickets", fields: [createdById], references: [id])
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  comments     TicketComment[]

  @@index([customerId])
  @@index([status])
  @@index([deletedAt])
}

model TicketComment {
  id        Int           @id @default(autoincrement())
  ticketId  Int
  userId    Int
  comment   String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  @@index([ticketId])
}

model Notification {
  id         Int      @id @default(autoincrement())
  customerId Int
  userId     Int
  title      String
  message    String
  type       String
  isRead     Boolean  @default(false)
  data       Json?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([userId])
  @@index([isRead])
  @@index([userId, isRead, createdAt])
  @@index([customerId, createdAt])
}

model UserDeviceToken {
