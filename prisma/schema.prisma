  id                  Int      @id @default(autoincrement())
  customerId          Int      @unique
  workingDaysPerMonth Int      @default(30)
  lateDeductionRate   Float    @default(0.0)
  overtimeMultiplier  Float    @default(1.5)
  pfPercent           Float    @default(12.0)
  esiPercent          Float    @default(0.75)
  taxExemptionLimit   Float    @default(300000)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Team {
  id          Int          @id @default(autoincrement())
  customerId  Int
  name        String
  description String?
  leaderId    Int?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  works       Work[]

  @@index([customerId])
}

model TeamMember {
  id         Int      @id @default(autoincrement())
  teamId     Int
  employeeId Int
  role       String   @default("MEMBER")
  joinedAt   DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, employeeId])
  @@index([teamId])
  @@index([employeeId])
}

model PlanEntitlement {
  id           Int       @id @default(autoincrement())
  customerId   Int
  planId       Int?
  serviceName  String
  totalQty     Int       @default(0)
  usedQty      Int       @default(0)
  scheduledQty Int       @default(0)
  validUntil   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  works        Work[]

  @@index([customerId])
}

model Work {
  id             Int                   @id @default(autoincrement())
  customerId     Int
  subscriptionId Int?
  planId         Int?
  entitlementId  Int?
  teamId         Int?
  assignedToId   Int?
  editorId       Int?
  workType       WorkType              @default(REELS_SHOOT)
  title          String
  description    String?
  scheduledDate  DateTime              @default(now())
  scheduledTime  String?
  status         WorkStatus            @default(SCHEDULED)
  priority       WorkPriority          @default(MEDIUM)
  notes          String?
  outputUrl      String?
  feedback       String?
  revisionCount  Int                   @default(0)
  submittedAt    DateTime?
  approvedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  assignedTo     Employee?             @relation("AssignedEmployeeWorks", fields: [assignedToId], references: [id])
  editor         Employee?             @relation("AssignedEditorWorks", fields: [editorId], references: [id])
  customer       Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscription   CustomerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  entitlement    PlanEntitlement?      @relation(fields: [entitlementId], references: [id])
  team           Team?                 @relation(fields: [teamId], references: [id])
  tasks          WorkTask[]

  @@index([customerId])
  @@index([subscriptionId])
  @@index([teamId])
  @@index([assignedToId])
  @@index([editorId])
  @@index([scheduledDate])
  @@index([status])
  @@index([customerId, scheduledDate])
  @@index([customerId, status])
}

model WorkTask {
  id           Int        @id @default(autoincrement())
  workId       Int
  title        String
  stepOrder    Int        @default(1)
  assignedToId Int?
  status       TaskStatus @default(PENDING)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignedTo   Employee?  @relation(fields: [assignedToId], references: [id])
  work         Work       @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@index([assignedToId])
}

model DataCaptureJob {
  id                Int                @id @default(autoincrement())
  jobId             String             @unique
  customerId        Int
  userId            Int
  keyword           String
  location          String
  requestedResults  Int                @default(20)
  capturedResults   Int                @default(0)
  googleApiRequests Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  places            DataCapturePlace[]

  @@index([customerId])
  @@index([jobId])
}

model DataCapturePlace {
  id             Int             @id @default(autoincrement())
  jobId          String?
  customerId     Int
  googlePlaceId  String?
  businessName   String
  category       String?
  address        String?
  phone          String?
  email          String?
  website        String?
  rating         Float?
  reviewCount    Int?
  latitude       Float?
  longitude      Float?
  googleMapsUrl  String?
  businessStatus String?         @default("OPERATIONAL")
  source         String?         @default("GOOGLE_PLACES")
  status         String?         @default("CAPTURED")
  rawData        Json?
  notes          String?
