# ============================================================================
# QuikBoom CRM Backend — local development environment (TEMPLATE)
#
# Copy to `.env` and fill in values:  cp .env.example .env
# `.env` is git-ignored. For production, see deploy/docker/.env.example instead
# (deploy scripts inject env vars into the container directly).
# ============================================================================

# ---- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---- PostgreSQL (matches docker-compose.yml) ---------------------------------
DATABASE_URL="postgresql://quikboom_user:quikboom_pass@localhost:5432/quikboom_crm?schema=public"

# ---- Auth (used by AuthModule / JwtStrategy) --------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---- Encryption (used by crypto.util.ts for storing integration secrets in DB)
# If omitted, falls back to JWT_SECRET. Set explicitly for stronger isolation.
ENCRYPTION_KEY=

# ---- Google Maps (used by DataCaptureModule) --------------------------------
GOOGLE_MAPS_API_KEY=

# =============================================================================
# FIREBASE ADMIN SDK (Server-side only — NEVER expose to frontend/mobile apps)
# =============================================================================
#
# OPTION A — Individual environment variables (recommended for cloud deployments)
# Copy values from your Firebase Console > Project Settings > Service Accounts > JSON file.
# Keep the private key exactly as-is, including surrounding quotes in the .env file.
#
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OPTION B — Inline JSON (alternative; useful for container/Docker secrets)
# Set to the full contents of the service-account JSON, serialized as a single-line string.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# OPTION C — File path (local development only; file must be git-ignored)
# Point to the absolute path of your service-account JSON file on disk.
# The file must NOT be inside the repository or the frontend directory.
# FIREBASE_SERVICE_ACCOUNT_PATH=/secure/path/outside/repo/firebase-service-account.json

# OPTION D — Google Application Default Credentials (GCP / Cloud Run)
# Set this when running on GCP with Workload Identity or Application Default Credentials.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

# -----------------------------------------------------------------------------
# Firebase Client SDK variables (used only by frontend/admin panel — NOT secrets)
# These are public and safe to commit, but kept here for documentation.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ---- Reserved — declared as dependencies but not yet wired into the app -----
# Redis / BullMQ (queues)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Razorpay (payments)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Cloudinary (media)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Nodemailer / SMTP (email)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
